FACTORY_API_KEY=
DAYTONA_API_KEY=
CHALK_API_KEY=
XAI_API_KEY=

# Prompt Print coaching: safe offline defaults. No browser receives these secrets.
PROMPTPRINT_MODE=mock
COACHING_MODE=shadow
CHALK_ROUTER_BASE_URL=https://api.chalk.ai/v1/router
CHALK_ENV_ID=
CHALK_ROUTER_API_KEY=
# Exact IDs from your gateway catalog; deliberately unset until account setup.
JEV_MODEL_ID=
SMALL_MODEL_ID=
LARGE_MODEL_ID=
JUDGE_MODEL_ID=
COACHING_PROFILE_PATH=
COACHING_POLICY_PATH=
COACHING_GENERAL_CONFIG_PATH=
# For live mode, use the shared nonsecret benchmark configuration:
# COACHING_PROFILE_PATH=config/coaching/profile.json
# COACHING_POLICY_PATH=config/coaching/policy.json
# COACHING_GENERAL_CONFIG_PATH=config/coaching/general-coach.json
# Keep the paths empty above for packaged mock defaults.
CLASSIFY_DEADLINE_MS=700
CLASSIFY_MAX_CONCURRENCY=8
EVAL_CONCURRENCY=2
EVAL_MAX_CALLS=100
EVAL_MAX_INPUT_TOKENS=100000
# Leave unset: no verified pricing table exists yet; setting a dollar cap fails closed.
EVAL_MAX_COST_USD=
APP_SESSION_SECRET=
# Leave unset locally. The Docker image defaults to /data; mount a Railway volume there.
# Routes jobs, repaired adapters, parser cache, NASA cache and the default coaching DB here.
PROMPTPRINT_DATA_DIR=
# An explicit DATABASE_URL overrides the data-directory default. On Railway use
# sqlite:////data/coaching.db, or omit DATABASE_URL to use PROMPTPRINT_DATA_DIR.
DATABASE_URL=sqlite:///artifacts/coaching.db
ALLOWED_ORIGINS=
METADATA_RETENTION_DAYS=7
