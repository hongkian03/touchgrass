{
  "openapi": "3.1.0",
  "info": {
    "title": "Prompt Print coaching",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/coaching/pair": {
      "post": {
        "summary": "Pair",
        "operationId": "pair_coaching_pair_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/classify": {
      "post": {
        "summary": "Classify",
        "operationId": "classify_classify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/coaching/events": {
      "post": {
        "summary": "Events",
        "operationId": "events_coaching_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoachingEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/coaching/history": {
      "delete": {
        "summary": "Clear",
        "operationId": "clear_coaching_history_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/evals/summary": {
      "get": {
        "summary": "Summary",
        "operationId": "summary_evals_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClassifyRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "draft_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Draft Revision"
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "site": {
            "type": "string",
            "maxLength": 40,
            "title": "Site"
          },
          "current_model_label": {
            "type": "string",
            "maxLength": 200,
            "title": "Current Model Label"
          },
          "prompt_text": {
            "type": "string",
            "maxLength": 12000,
            "title": "Prompt Text"
          },
          "recent_messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Recent Messages"
          },
          "opted_in": {
            "type": "boolean",
            "title": "Opted In",
            "default": false
          },
          "context_available": {
            "type": "boolean",
            "title": "Context Available",
            "default": true
          },
          "context_truncated": {
            "type": "boolean",
            "title": "Context Truncated",
            "default": false
          },
          "has_attachments": {
            "type": "boolean",
            "title": "Has Attachments",
            "default": false
          },
          "uses_tools": {
            "type": "boolean",
            "title": "Uses Tools",
            "default": false
          },
          "modality": {
            "type": "string",
            "maxLength": 40,
            "title": "Modality",
            "default": "text"
          },
          "target_available": {
            "type": "boolean",
            "title": "Target Available",
            "default": false
          },
          "mock_fixture_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Mock Fixture Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "draft_revision",
          "conversation_id",
          "site",
          "current_model_label",
          "prompt_text"
        ],
        "title": "ClassifyRequest"
      },
      "ClassifyResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "draft_revision": {
            "type": "integer",
            "title": "Draft Revision"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "site": {
            "type": "string",
            "title": "Site"
          },
          "current_model_label": {
            "type": "string",
            "title": "Current Model Label"
          },
          "decision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Decision Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "live"
            ],
            "title": "Mode"
          },
          "classification": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "small_ok",
                  "needs_big",
                  "uncertain"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Classification"
          },
          "action": {
            "type": "string",
            "enum": [
              "suggest_small",
              "keep_current",
              "abstain"
            ],
            "title": "Action"
          },
          "reason_code": {
            "type": "string",
            "title": "Reason Code"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Target"
              },
              {
                "type": "null"
              }
            ]
          },
          "estimated_savings": {
            "type": "null",
            "title": "Estimated Savings"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "profile_version": {
            "type": "string",
            "title": "Profile Version"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version"
          },
          "policy_status": {
            "type": "string",
            "title": "Policy Status"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          },
          "ttl_ms": {
            "type": "integer",
            "title": "Ttl Ms",
            "default": 30000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "draft_revision",
          "conversation_id",
          "site",
          "current_model_label",
          "decision_id",
          "mode",
          "classification",
          "action",
          "reason_code",
          "profile_version",
          "policy_version",
          "policy_status",
          "elapsed_ms"
        ],
        "title": "ClassifyResponse"
      },
      "CoachingEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "decision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Decision Id"
          },
          "draft_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Draft Revision"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "shown",
              "dismissed",
              "switch_clicked",
              "switch_confirmed",
              "sent_anyway",
              "sent_with_target",
              "expired",
              "late_result"
            ],
            "title": "Event Type"
          },
          "client_time": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Time"
          },
          "source_label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Label"
          },
          "target_label": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Label"
          },
          "exchange_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "decision_id",
          "draft_revision",
          "event_type"
        ],
        "title": "CoachingEvent"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "PairingRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 100,
            "minLength": 20,
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "PairingRequest"
      },
      "Target": {
        "properties": {
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "website_label": {
            "type": "string",
            "title": "Website Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_id",
          "website_label"
        ],
        "title": "Target"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
